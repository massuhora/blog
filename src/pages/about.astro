---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About">
  <div class="max-w-3xl mx-auto">
    <header class="mb-12 text-center" transition:animate="fade">
      <h1 class="text-5xl mb-4">About</h1>
      <p class="text-xl text-muted-foreground">
        A little bit about me and this blog
      </p>
    </header>
    
    <div class="prose prose-lg dark:prose-invert max-w-none" transition:animate="fade">
      <p>
        Hi, I'm <strong>Massu Hora</strong>. Welcome to my personal blog! This is a space where I share my thoughts, 
        experiences, and things I find interesting. Built with Astro and Tailwind CSS, 
        this blog is designed to be fast, clean, and focused on the content.
      </p>
      
      <h2>What to Expect</h2>
      
      <ul>
        <li>Thoughts on technology, programming, and software development</li>
        <li>Personal projects and learnings along the way</li>
        <li>Explorations of ideas and random curiosities</li>
        <li>Clean, readable content without distractions</li>
      </ul>
      
      <h2>Get in Touch</h2>
      
      <p>
        Feel free to reach out if you want to discuss anything you read here. You can find me on:
      </p>
      
      <ul>
        <li><a href="https://x.com/massuhora" target="_blank" rel="noopener noreferrer">X (Twitter) — @massuhora</a></li>
        <li><a href="https://github.com/massuhora" target="_blank" rel="noopener noreferrer">GitHub — @massuhora</a></li>
      </ul>
    </div>
  </div>
</BaseLayout>
